#!/usr/bin/env bash
# 本地预提交检查（启用：git config core.hooksPath .githooks）
#   1) 暂存的 .go 文件必须已 gofmt
#   2) 暂存的 frontend/src 文件必须通过 ESLint——只在 frontend/node_modules 里装了 eslint 时才跑，
#      没装依赖的贡献者不会被卡住（CI 里 ESLint 是阻塞闸，这里只是提前暴露）
set -euo pipefail

status=0

staged_go=$(git diff --cached --name-only --diff-filter=ACM -- "*.go" || true)
if [ -n "$staged_go" ]; then
  bad=$(gofmt -l $staged_go || true)
  if [ -n "$bad" ]; then
    echo "以下 Go 文件未格式化，请运行 make fmt 后重新提交:" >&2
    echo "$bad" >&2
    status=1
  fi
fi

eslint_bin="frontend/node_modules/.bin/eslint"
mapfile -t staged_frontend < <(git diff --cached --name-only --diff-filter=ACM -- "frontend/src/**" || true)
if [ "${#staged_frontend[@]}" -gt 0 ]; then
  if [ -x "$eslint_bin" ]; then
    files=()
    for f in "${staged_frontend[@]}"; do
      files+=("${f#frontend/}")
    done
    if ! (cd frontend && ./node_modules/.bin/eslint --ext .js,.ts,.vue --max-warnings 0 "${files[@]}"); then
      echo "ESLint 未通过：可运行 (cd frontend && npx eslint --fix --ext .js,.ts,.vue ./src) 后重新提交" >&2
      status=1
    fi
  else
    echo "跳过前端 ESLint：frontend/node_modules 未安装（CI 仍会检查）" >&2
  fi
fi

exit $status
