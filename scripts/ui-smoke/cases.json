    { "name": "漏洞结果-任务空", "hash": "#/asset-information/nuclei-result?taskName=__none__", "assert": "contextualEmpty" },
    { "name": "漏洞结果-主机空", "hash": "#/asset-information/nuclei-result?host=__none__", "assert": "contextualEmpty" },
    { "name": "资产-资产Tab", "hash": "#/asset-information/index?tab=asset", "assert": "tableOrEmpty" },
    { "name": "资产-子域Tab空", "hash": "#/asset-information/index?tab=subdomain&search=task%3D%3D%22__none__%22", "assert": "contextualEmpty" },
    { "name": "资产-IP Tab空", "hash": "#/asset-information/index?tab=ip&search=task%3D%3D%22__none__%22", "assert": "contextualEmpty" },
    { "name": "资产-漏洞Tab空", "hash": "#/asset-information/index?tab=vul&search=task%3D%3D%22__none__%22", "assert": "contextualEmpty" },
    { "name": "任务列表", "hash": "#/task-management/ScanTask", "assert": "hasToolbar" },
    { "name": "节点列表", "hash": "#/node-management/index", "assert": "hasColumns" },
    { "name": "POC管理", "hash": "#/poc-management/index", "assert": "tableOrEmpty" },
    { "name": "指纹管理", "hash": "#/fingerprint-management", "assert": "tableOrEmpty" },
    { "name": "敏感信息规则", "hash": "#/sensitive-information-rules", "assert": "tableOrEmpty" },
    { "name": "系统配置", "hash": "#/configuration/system", "assert": "hasButtons" },
    { "name": "重置-漏洞主机筛选", "hash": "#/asset-information/nuclei-result?host=__none__", "assert": "resetWorks" },
    { "name": "重置-漏洞任务筛选", "hash": "#/asset-information/nuclei-result?taskName=__none__", "assert": "resetWorks" },
    { "name": "弹窗-新建任务", "hash": "#/task-management/ScanTask", "assert": "dialogOpens", "label": "新建任务" },
    { "name": "弹窗-POC新建", "hash": "#/poc-management/index", "assert": "dialogOpens", "label": "新建" },
    { "name": "弹窗-指纹新建", "hash": "#/fingerprint-management", "assert": "dialogOpens", "label": "新建" },
    { "name": "弹窗-敏感规则新建", "hash": "#/sensitive-information-rules", "assert": "dialogOpens", "label": "新建" },
    { "name": "弹窗-项目新建", "hash": "#/project-management", "assert": "dialogOpens", "label": "新建项目" }
  ]
}
